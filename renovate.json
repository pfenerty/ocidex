{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "postUpdateOptions": ["gomodTidy", "npmDedupe"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "automerge": false,
    "labels": ["security", "renovate"]
  },
  "labels": ["renovate"],
  "packageRules": [
    {
      "description": "Automerge all minor and patch updates (specific group rules override the groupName below)",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Group all Go module updates into one PR",
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "automerge": true
    },
    {
      "description": "Group .tektonic/ npm updates; keeps CI pipeline deps separate from the web app",
      "matchManagers": ["npm"],
      "matchFileNames": [".tektonic/package.json"],
      "groupName": "tektonic pipeline dependencies",
      "automerge": true
    },
    {
      "description": "Group web/ npm updates separately from .tektonic/",
      "matchManagers": ["npm"],
      "matchFileNames": ["web/package.json"],
      "groupName": "web dependencies",
      "automerge": true
    },
    {
      "description": "Track @pfenerty/tektonic minor/patch via git tags — automerge, bump before re-synth",
      "matchPackageNames": ["@pfenerty/tektonic"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tektonic",
      "automerge": true
    },
    {
      "description": "@pfenerty/tektonic major — hold for manual review and re-synth",
      "matchPackageNames": ["@pfenerty/tektonic"],
      "matchUpdateTypes": ["major"],
      "groupName": "tektonic (major)",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump base/tool image tags in the tektonic TypeScript source (.tektonic/**/*.ts) in lockstep with the generated .tekton/ YAML, so re-synthesis never reverts a Renovate bump.",
      "managerFilePatterns": ["/\\.tektonic/.*\\.ts$/"],
      "matchStrings": [
        "image:\\s*\"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\"",
        "Image\\s*=\\s*\"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
