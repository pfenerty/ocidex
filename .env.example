# OCIDex Configuration
# Copy to .env and fill in required values.
# See docs/CONFIGURATION.md for full reference.
#
# Read by docker-compose (env_file:) and by the Makefile, which exports it before
# running any target. The binaries read only the process environment — running
# ./bin/ocidex directly ignores this file.

# ── Core ──────────────────────────────────────────────────────────────────────

PORT=8080
LOG_LEVEL=info
ENVIRONMENT=development

# Required. Run migrations explicitly with `ocidex migrate up` or `make migrate-up`.
DATABASE_URL=postgres://ocidex:ocidex@localhost:5432/ocidex?sslmode=disable

# ── Authentication ────────────────────────────────────────────────────────────
# SESSION_SECRET is always required, plus at least one identity provider below —
# GitHub, OIDC, or both. The app will not start with no provider configured.
# Note the Tiltfile additionally requires the GitHub pair in this file, because
# the Tilt cluster rig has no issuer of its own to point at.

# Min 32 bytes. Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=7

# ── Credential encryption (ADR-051) ───────────────────────────────────────────
# Encrypts registry auth tokens and webhook secrets in the database. Required when
# ENVIRONMENT=production; unset in development stores them in plaintext.
# Generate a key with: openssl rand -base64 32
# DATA_ENCRYPTION_KEYS=k1:<base64 32 bytes>
# DATA_ENCRYPTION_ACTIVE_KEY=k1

# ── Provider: GitHub OAuth ────────────────────────────────────────────────────
# Set both or neither; one without the other is a startup error.
# Create an OAuth App at https://github.com/settings/developers

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must be registered in your GitHub OAuth App.
# When accessing via Tailscale or a remote IP, set to that address, e.g.:
#   GITHUB_REDIRECT_URL=http://100.104.73.75:8080/auth/callback
GITHUB_REDIRECT_URL=http://localhost:8080/auth/callback

# ── Provider: generic OIDC ────────────────────────────────────────────────────
# Setting OIDC_ISSUER_URL enables it. Discovery runs at startup, so a wrong URL
# stops the process rather than producing a login button that fails on click.
# OIDC_NAME is the permanent second half of the `oidc:<name>` provider key stored
# against every account signed in through this issuer — changing it later orphans
# those accounts. See docs/CONFIGURATION.md and docs/adr/0047.
#
#   OIDC_ISSUER_URL=https://accounts.google.com
#   OIDC_CLIENT_ID=
#   OIDC_CLIENT_SECRET=      # omit for a public client; PKCE is used regardless
#   OIDC_NAME=google

# ── First admin ───────────────────────────────────────────────────────────────
# Identities promoted to installation admin when they sign in, comma-separated:
# github:<numeric user id> or oidc:<name>:<sub>. Matched on provider + subject,
# never email. Nothing else creates an admin. See docs/CONFIGURATION.md.
#   BOOTSTRAP_ADMINS=github:12345678
BOOTSTRAP_ADMINS=

# Installation policy. "existing" signs in only accounts that already exist
# (plus BOOTSTRAP_ADMINS); SELF_SERVICE_NAMESPACES=false stops global viewers
# creating namespaces. Defaults keep sign-up and namespace creation open.
# SIGNUP_MODE=open
# SELF_SERVICE_NAMESPACES=true

# ── Frontend / CORS ───────────────────────────────────────────────────────────

# Post-login redirect target. Only the port matters; hostname is derived from
# the login request. Set to match wherever the frontend is served.
FRONTEND_URL=http://localhost:3000

# Must NOT be '*' when credentials are involved. Should match FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: populates the OpenAPI servers block for tooling/docs.
# API_BASE_URL=http://localhost:8080

# ── Database Pool ─────────────────────────────────────────────────────────────

# DATABASE_MAX_CONNECTIONS=10

# ── Enrichment Pipeline (enricher workers only) ───────────────────────────────
# Read by each cmd/<name>-worker; the API does not enrich in-process.

# ENRICHMENT_WORKERS=2
# ENRICHMENT_QUEUE_SIZE=100

# ── OCI Registry Scanner ──────────────────────────────────────────────────────
# Webhook/poll-triggered scanning. The scan engine runs in cmd/scanner-worker
# (a separate process), so SCANNER_ENABLED=true on the API enables the webhook
# and poller paths but requires a scanner-worker container to actually scan —
# docker-compose.yml starts one. Set to false to run the API without scanning;
# the scan-trigger endpoint then returns 503.

SCANNER_ENABLED=true
# SCANNER_MAX_CONCURRENCY=10

# Background poller for poll/both scan-mode registries. Required to register
# GHCR or any other poll-only registry type — without it those registries are
# rejected 422 at creation. Has no effect unless SCANNER_ENABLED=true.
REGISTRY_POLLER_ENABLED=true

# ── Egress guard ──────────────────────────────────────────────────────────────
# Which addresses registry dials may reach (docs/CONFIGURATION.md "Egress
# Policy"). Private ranges are refused by default; local dev registries live on
# them, so allow them here. Loopback and cloud metadata stay refused unless
# EGRESS_ALLOW_CIDRS names them.
EGRESS_ALLOW_PRIVATE=true
# EGRESS_ALLOW_CIDRS=
# EGRESS_DENY_CIDRS=

# ── Provenance Reverification ─────────────────────────────────────────────────
# Periodic drift-detection sweep for verified SBOMs. Runs on the API via leader
# election; enabled by default since it already runs unconditionally today.

# PROVENANCE_REVERIFIER_ENABLED=true
# PROVENANCE_RECHECK_INTERVAL=24h

# ── NATS JetStream ────────────────────────────────────────────────────────────
# Required. The API publishes events; workers consume from JetStream.

NATS_URL=nats://localhost:4222
# NATS_STREAM_NAME=ocidex
# NATS_EVENT_TTL_HOURS=24
# NATS_STREAM_REPLICAS=1    # Set to 3 for a 3-node NATS cluster

# ── Audit Logging ─────────────────────────────────────────────────────────────

# AUDIT_LOG_ENABLED=true
